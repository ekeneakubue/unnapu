# Cloudflare R2 — copy values into .env
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public URL for objects (r2.dev subdomain or custom domain), no trailing slash
R2_PUBLIC_URL=

# Session signing secret (set a long random string in production)
SESSION_SECRET=

# Optional: comma-separated hostnames/IPs for dev server actions (see next.config.ts)
# ALLOWED_DEV_ORIGINS=192.168.1.10,10.0.0.5
